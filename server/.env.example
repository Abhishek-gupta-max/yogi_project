# Copy this file to server/.env and fill in real values

PORT=5000

# Gmail SMTP (free). SMTP_PASS must be a Gmail "App Password" (16 chars),
# NOT your normal Gmail password. Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where contact form messages are delivered
MAIL_TO=info@veltrixsecure.com

# formsubmit = free, no password (one-time activation click in MAIL_TO inbox)
# smtp       = Gmail SMTP, needs SMTP_USER + SMTP_PASS above
MAIL_PROVIDER=formsubmit
SITE_URL=http://localhost:5173

# XAMPP MySQL (phpMyAdmin: http://localhost/phpmyadmin/)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shiftahead
